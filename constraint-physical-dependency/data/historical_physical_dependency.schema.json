{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HYDRA Constraint Historical Physical Dependency Record",
  "type": "object",
  "required": ["record_id","subject_id","subject_kind","valid_from","known_at","provenance"],
  "properties": {
    "record_id":{"type":"string","minLength":1},
    "subject_id":{"type":"string","minLength":1},
    "subject_kind":{"enum":["resource","deposit_source","extraction","processing","transport","infrastructure","manufacturing","product_technology","company","country","bottleneck","substitute","beneficiary"]},
    "valid_from":{"type":"string","format":"date"},
    "valid_to":{"type":["string","null"],"format":"date"},
    "known_at":{"type":"string","format":"date"},
    "capacity_nameplate":{"type":["number","null"],"minimum":0},
    "capacity_usable":{"type":["number","null"],"minimum":0},
    "capacity_unit":{"type":["string","null"]},
    "market_share":{"type":["number","null"],"minimum":0,"maximum":1},
    "source_url":{"type":"string"},
    "publisher":{"type":"string"},
    "provenance":{"type":"object","minProperties":1}
  },
  "additionalProperties": true
}

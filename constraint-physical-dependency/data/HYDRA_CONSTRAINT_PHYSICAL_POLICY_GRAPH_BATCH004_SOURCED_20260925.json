{
  "schema_version": "1.0",
  "batch_id": "HYDRA_CONSTRAINT_PHYSICAL_POLICY_CASE_GRAPH_BATCH004_20260925",
  "evidence_digest_scope": "sha256(normalized_evidence UTF-8)",
  "sources": [
    {
      "source_id": "wto-2019-07-10-japan-korea-goods-council",
      "source_url": "https://www.wto.org/english/news_e/news19_e/good_10jul19_e.htm",
      "publisher": "World Trade Organization",
      "retrieved_at": "2026-09-25",
      "known_at": "2019-07-10",
      "published_at": "2019-07-10",
      "normalized_evidence": "On 10 July 2019, the WTO reported that Korea told the Goods Council that Japan had issued an export-control measure on 1 July, effective 4 July, requiring individual licences for shipments to Korea, while Japan stated that the measure was an operational review of its export-control procedures rather than a trade embargo.",
      "evidence_hash": "sha256:dedc873ad5dca8e46b0f0d7902377adbc36c948c1f05be6a24afedf37146d7b8"
    },
    {
      "source_id": "wto-ds590-2019-09-16",
      "source_url": "https://www.wto.org/english/news_e/news19_e/ds590rfc_16sep19_e.htm",
      "publisher": "World Trade Organization",
      "retrieved_at": "2026-09-25",
      "known_at": "2019-09-16",
      "published_at": "2019-09-16",
      "normalized_evidence": "On 16 September 2019, the WTO reported Korea's request for consultations concerning Japanese licensing policies and procedures affecting fluorinated polyimide, resist polymers and hydrogen fluoride, and related technologies, noting that those products are used primarily in smartphone and television displays and semiconductors.",
      "evidence_hash": "sha256:fbe39b6b2a00538cb96eda9aaac1772d461f975417a4f81579d6a37cf7e7a9e7"
    },
    {
      "source_id": "consilium-2019-11-11-eastmed-framework",
      "source_url": "https://www.consilium.europa.eu/en/press/press-releases/2019/11/11/turkey-s-illegal-drilling-activities-in-the-eastern-mediterranean-council-adopts-framework-for-sanctions/",
      "publisher": "Council of the European Union",
      "retrieved_at": "2026-09-25",
      "known_at": "2019-11-11",
      "published_at": "2019-11-11",
      "normalized_evidence": "On 11 November 2019, the Council of the European Union adopted a framework for restrictive measures concerning what it described as unauthorised drilling activities related to hydrocarbon exploration and production in the Eastern Mediterranean, including activities connected with areas claimed by Cyprus.",
      "evidence_hash": "sha256:802566582b3510701feabe97bab4f3b224d6e425da531030754cd90a17f83f39"
    },
    {
      "source_id": "bnetza-2021-11-16-nordstream2-suspension",
      "source_url": "https://www.bundesnetzagentur.de/SharedDocs/Pressemitteilungen/EN/2021/20211116_NOS2.html",
      "publisher": "Bundesnetzagentur",
      "retrieved_at": "2026-09-25",
      "known_at": "2021-11-16",
      "published_at": "2021-11-16",
      "normalized_evidence": "On 16 November 2021, Germany's Federal Network Agency suspended the procedure to certify Nord Stream 2 AG as an independent transmission operator, stating that certification would require the operator for the German part of the pipeline to be organised under German law and that the procedure would remain suspended until specified assets, personnel and documentation were transferred and resubmitted.",
      "evidence_hash": "sha256:4e29456b6890730daa0460e2492f8b06789eded217f4ab1ab4e6faee87a8989c"
    },
    {
      "source_id": "bmwk-2022-02-22-nordstream2-halt",
      "source_url": "https://www.bmwk.de/Redaktion/EN/Pressemitteilungen/2022/02/20220222-minister-habeck-comments-on-the-situation-in-eastern-ukraine-and-the-discontinuation-of-the-certification-procedure-for-nord-stream-2.html",
      "publisher": "German Federal Ministry for Economic Affairs and Climate Action",
      "retrieved_at": "2026-09-25",
      "known_at": "2022-02-22",
      "published_at": "2022-02-22",
      "normalized_evidence": "On 22 February 2022, Germany's Federal Ministry for Economic Affairs and Climate Action announced that the Federal Government had withdrawn the prior Security of Supply Report for Nord Stream 2 and halted the certification procedure pending a reassessment, stating that a positive certification decision could not be issued while the report remained withdrawn.",
      "evidence_hash": "sha256:eeceedbbd2141e47138fc3134b599ef192ed9bed2836c8e06e1d93b5828d3ab2"
    },
    {
      "source_id": "govinfo-2022-08-16-pl117-169-45x",
      "source_url": "https://www.govinfo.gov/content/pkg/PLAW-117publ169/html/PLAW-117publ169.htm",
      "publisher": "U.S. Government Publishing Office",
      "retrieved_at": "2026-09-25",
      "known_at": "2022-08-16",
      "published_at": "2022-08-16",
      "normalized_evidence": "Public Law 117-169, enacted on 16 August 2022, created Internal Revenue Code section 45X, the Advanced Manufacturing Production Credit, and provided that the amendments apply to eligible components produced and sold after 31 December 2022.",
      "evidence_hash": "sha256:b5d77f98ae83f736c5e337ce601a57b1666345329390cbb4474ded01bc289079"
    },
    {
      "source_id": "bmwk-2022-12-17-wilhelmshaven-opening",
      "source_url": "https://www.bmwk.de/Redaktion/EN/Pressemitteilungen/2022/12/20221217-first-german-lng-terminal-inaugurated-in-wilhelmshaven.html",
      "publisher": "German Federal Ministry for Economic Affairs and Climate Action",
      "retrieved_at": "2026-09-25",
      "known_at": "2022-12-17",
      "published_at": "2022-12-17",
      "normalized_evidence": "On 17 December 2022, Germany's Federal Ministry for Economic Affairs and Climate Action announced the official opening of the first German floating LNG import terminal at Wilhelmshaven, stating that the Hoegh Esperanza FSRU would begin first regasification within days and would provide around 5 billion cubic metres per year of regasification capacity from January.",
      "evidence_hash": "sha256:53b693aff81e79b422a2ed04ccf9bf7eb5ed799b2ff898f1ceccb0a67286bc40"
    }
  ],

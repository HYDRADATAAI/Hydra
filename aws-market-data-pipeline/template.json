{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Deployment-ready HYDRA synthetic market-data vertical slice. Not production infrastructure.",
  "Parameters": {
    "ArtifactRetentionDays": {
      "Type": "Number",
      "Default": 30,
      "MinValue": 1,
      "MaxValue": 90
    },
    "CuratedBucketName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
      "Description": "Globally unique private S3 bucket name for curated sample artifacts."
    },
    "DataCatalogDatabaseName": {
      "Type": "String",
      "Default": "hydra_public_market_data",
      "AllowedPattern": "^[a-z0-9_]+$",
      "Description": "Athena-compatible Glue database name for the public sample."
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 14,
      "AllowedValues": [1, 3, 5, 7, 14, 30]
    },
    "MaxSourceObjectBytes": {
      "Type": "String",
      "Default": "1048576",
      "AllowedPattern": "^(?:[1-9][0-9]{0,5}|1[0-9]{6}|2000000)$",
      "Description": "Maximum CSV object size accepted by the Lambda transform, from 1 through 2000000 bytes."
    },
    "RawBucketName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
      "Description": "Globally unique private S3 bucket name for synthetic source objects."
    }
  },
  "Resources": {
    "RawBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "BucketName": {"Ref": "RawBucketName"},
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "ExpirationInDays": {"Ref": "ArtifactRetentionDays"},
              "Id": "ExpireSyntheticRawObjects",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": {"Ref": "ArtifactRetentionDays"}
              },
              "Prefix": "raw/",
              "Status": "Enabled"
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {"Key": "hydra:sample", "Value": "aws-market-data-pipeline"},
          {"Key": "hydra:data-boundary", "Value": "synthetic-non-live"}
        ],
        "VersioningConfiguration": {"Status": "Enabled"}
      }
    },
    "CuratedBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "BucketName": {"Ref": "CuratedBucketName"},
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "ExpirationInDays": {"Ref": "ArtifactRetentionDays"},
              "Id": "ExpireSyntheticCuratedObjects",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": {"Ref": "ArtifactRetentionDays"}
              },
              "Prefix": "",
              "Status": "Enabled"
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {"Key": "hydra:sample", "Value": "aws-market-data-pipeline"},
          {"Key": "hydra:data-boundary", "Value": "synthetic-non-live"}
        ],
        "VersioningConfiguration": {"Status": "Enabled"}
      }
    },
    "TransformFunction": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Architectures": ["x86_64"],
        "CodeUri": "function/",
        "Environment": {
          "Variables": {
            "CURATED_BUCKET": {"Ref": "CuratedBucket"},
            "DATA_CATALOG_DATABASE": {"Ref": "DataCatalogDatabaseName"},
            "MAX_SOURCE_OBJECT_BYTES": {"Ref": "MaxSourceObjectBytes"}
          }
        },
        "Events": {
          "RawCsvUpload": {
            "Type": "S3",
            "Properties": {
              "Bucket": {"Ref": "RawBucket"},
              "Events": "s3:ObjectCreated:*",
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {"Name": "prefix", "Value": "raw/"},
                    {"Name": "suffix", "Value": ".csv"}
                  ]
                }
              }
            }
          }
        },
        "Handler": "app.lambda_handler",
        "MemorySize": 128,
        "Policies": [
          {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["s3:GetObject", "s3:GetObjectVersion"],
                "Resource": {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${RawBucketName}/raw/*"
                }
              },
              {
                "Effect": "Allow",
                "Action": ["s3:PutObject"],
                "Resource": {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${CuratedBucketName}/curated/*"
                }
              },
              {
                "Effect": "Allow",
                "Action": ["glue:CreatePartition", "glue:GetPartition"],
                "Resource": [
                  {"Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:catalog"},
                  {"Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/${DataCatalogDatabaseName}"},
                  {"Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/${DataCatalogDatabaseName}/normalized_events"}
                ]
              }
            ]
          }
        ],
        "ReservedConcurrentExecutions": 2,
        "Runtime": "python3.11",
        "Tags": {
          "hydra:sample": "aws-market-data-pipeline",
          "hydra:data-boundary": "synthetic-non-live"
        },
        "Timeout": 30,
        "Tracing": "PassThrough"
      }
    },
    "TransformLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/${TransformFunction}"},
        "RetentionInDays": {"Ref": "LogRetentionDays"}
      }
    },
    "DataCatalogDatabase": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {"Ref": "AWS::AccountId"},
        "DatabaseInput": {
          "Description": "HYDRA synthetic non-live market-data sample",
          "Name": {"Ref": "DataCatalogDatabaseName"}
        }
      }
    },
    "NormalizedEventsTable": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {"Ref": "AWS::AccountId"},
        "DatabaseName": {"Ref": "DataCatalogDatabase"},
        "TableInput": {
          "Description": "Accepted synthetic HYDRA market events",
          "Name": "normalized_events",
          "Parameters": {"classification": "json"},
          "PartitionKeys": [{"Name": "pipeline_run_id", "Type": "string"}],
          "StorageDescriptor": {
            "Columns": [
              {"Name": "currency", "Type": "string"},
              {"Name": "event_id", "Type": "string"},
              {"Name": "event_time_utc", "Type": "string"},
              {"Name": "price", "Type": "string"},
              {"Name": "raw_record_sha256", "Type": "string"},
              {"Name": "source_file_sha256", "Type": "string"},
              {"Name": "source_record_id", "Type": "string"},
              {"Name": "source_row_number", "Type": "bigint"},
              {"Name": "source_system", "Type": "string"},
              {"Name": "symbol", "Type": "string"},
              {"Name": "transform_version", "Type": "string"},
              {"Name": "venue", "Type": "string"},
              {"Name": "volume", "Type": "bigint"}
            ],
            "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
            "Location": {"Fn::Sub": "s3://${CuratedBucket}/curated/accepted/"},
            "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
            "SerdeInfo": {
              "Parameters": {"ignore.malformed.jsons": "false"},
              "SerializationLibrary": "org.openx.data.jsonserde.JsonSerDe"
            }
          },
          "TableType": "EXTERNAL_TABLE"
        }
      }
    },
    "AthenaWorkGroup": {
      "Type": "AWS::Athena::WorkGroup",
      "Properties": {
        "Description": "Bounded queries over HYDRA synthetic non-live outputs",
        "Name": {"Fn::Sub": "hydra-public-${AWS::StackName}"},
        "RecursiveDeleteOption": true,
        "State": "ENABLED",
        "Tags": [
          {"Key": "hydra:sample", "Value": "aws-market-data-pipeline"},
          {"Key": "hydra:data-boundary", "Value": "synthetic-non-live"}
        ],
        "WorkGroupConfiguration": {
          "BytesScannedCutoffPerQuery": 1073741824,
          "EnforceWorkGroupConfiguration": true,
          "PublishCloudWatchMetricsEnabled": false,
          "ResultConfiguration": {
            "EncryptionConfiguration": {"EncryptionOption": "SSE_S3"},
            "OutputLocation": {"Fn::Sub": "s3://${CuratedBucket}/athena-results/"}
          }
        }
      }
    }
  },
  "Outputs": {
    "AthenaWorkGroupName": {"Value": {"Ref": "AthenaWorkGroup"}},
    "CuratedBucketName": {"Value": {"Ref": "CuratedBucket"}},
    "GlueDatabaseName": {"Value": {"Ref": "DataCatalogDatabase"}},
    "GlueTableName": {"Value": {"Ref": "NormalizedEventsTable"}},
    "RawBucketName": {"Value": {"Ref": "RawBucket"}},
    "TransformFunctionName": {"Value": {"Ref": "TransformFunction"}}
  }
}

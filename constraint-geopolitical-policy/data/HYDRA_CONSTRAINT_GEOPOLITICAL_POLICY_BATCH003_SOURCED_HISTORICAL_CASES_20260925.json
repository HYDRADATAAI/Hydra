      "url": "https://www.wto.org/english/news_e/news14_e/dsb_29aug14_e.htm",
      "published_at": "2014-08-29T23:59:59Z",
      "available_at": "2014-08-29T23:59:59Z",
      "normalized_evidence": "On 29 August 2014, the WTO Dispute Settlement Body adopted the Panel and Appellate Body reports in DS431, DS432 and DS433 concerning China's export restrictions on rare earths, tungsten and molybdenum; the WTO Secretariat summary recorded the parties' positions and the adopted findings.",
      "evidence_digest": "sha256:7d8f421c864e64fc993757ab7b2ad403d2edc19eb0b3f91b83ec3d6555d70a47"
    },
    {
      "source_id": "wto-2015-05-20-rare-earths-implementation",
      "publisher": "World Trade Organization",
      "url": "https://www.wto.org/english/news_e/news15_e/dsb_20may15_e.htm",
      "published_at": "2015-05-20T23:59:59Z",
      "available_at": "2015-05-20T23:59:59Z",
      "normalized_evidence": "On 20 May 2015, the WTO Secretariat reported that China informed the Dispute Settlement Body that export duties and export quotas on rare earths, tungsten and molybdenum, along with specified trading-right restrictions, had been removed; the United States stated that it still had concerns about an export licensing requirement.",
      "evidence_digest": "sha256:3c5abce7d24949ce07115a9ee55df8efb19ff4f794c79321360765c1e7f36f7c"
    }

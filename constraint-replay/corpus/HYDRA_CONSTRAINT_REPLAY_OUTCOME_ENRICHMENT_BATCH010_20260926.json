{
  "schema_version": "1.0",
  "batch_id": "HYDRA_CONSTRAINT_REPLAY_OUTCOME_ENRICHMENT_BATCH010_20260926",
  "evidence_digest_scope": "sha256(normalized_evidence UTF-8)",
  "policy": "Batch 010 expands the existing uncalibrated classified-gold path to Section 301 trade actions, China gallium/germanium export controls, and IMO 2020 sulfur regulation. It reuses the same publisher-independence, confidence-admissibility, and outcome-mapping rules.",
  "sources": [
    {
      "source_id": "section301-fed-beige-book-2018-09-12",
      "role": "HISTORICAL_HYPOTHESIS",
      "publisher": "Board of Governors of the Federal Reserve System",
      "url": "https://www.federalreserve.gov/monetarypolicy/beigebook201809.htm",
      "published_at": "2018-09-12T23:59:59Z",
      "available_at": "2018-09-12T23:59:59Z",
      "normalized_evidence": "On 12 September 2018, the Federal Reserve Beige Book reported widespread input-price pressures, said tariffs were contributing to rising input costs mainly for manufacturers, and reported that nearly two-thirds of commenting manufacturing firms had experienced or anticipated price hikes and/or supply disruptions because of tariffs and the threat of tariffs.",
      "evidence_digest": "sha256:2bbe8a121a6a9b21a6c6dc1d5aac358544664a06a044a7c973a351423fbe7c0d"
    },
    {
      "source_id": "section301-usitc-2023-03-15-effects",
      "role": "OUTCOME",
      "publisher": "United States International Trade Commission",
      "url": "https://www.usitc.gov/press_room/news_release/2023/er0315_63679.htm",
      "published_at": "2023-03-15T23:59:59Z",
      "available_at": "2023-03-15T23:59:59Z",
      "observed_at": "2023-03-15T23:59:59Z",
      "normalized_evidence": "On 15 March 2023, the U.S. International Trade Commission reported that, on average during 2018-2021, Section 301 tariffs reduced affected imports from China by 13 percent, increased U.S. prices for covered products by 0.2 percent, and increased the value of U.S. production by 0.4 percent; for semiconductors, the estimates were a 72.3 percent import reduction, 4.1 percent price increase, and 6.4 percent production-value increase.",
      "evidence_digest": "sha256:6ff574fa949a75e3cfdff01ca6d21e83014997b331783b53510196bc0d75ba15"
    },
    {
      "source_id": "gagermanium-iea-2023-07-11-hypothesis",
      "role": "HISTORICAL_HYPOTHESIS",
      "publisher": "International Energy Agency",
      "url": "https://www.iea.org/reports/critical-minerals-market-review-2023/implications",
      "published_at": "2023-07-11T23:59:59Z",
      "available_at": "2023-07-11T23:59:59Z",
      "normalized_evidence": "On 11 July 2023, the International Energy Agency's Critical Minerals Market Review stated that the July export curbs on Chinese gallium and germanium highlighted the significance of niche critical minerals with high supply concentration and illustrated how reliance on a small group of suppliers may disrupt supply chains.",
      "evidence_digest": "sha256:09f6b088a44716989820dcc0649c03668afdfdb45f6de0d7f157f80e1c7e7355"
    },
    {
      "source_id": "gagermanium-usgs-2024-01-30-gallium",
      "role": "OUTCOME",
      "publisher": "U.S. Geological Survey",
      "url": "https://pubs.usgs.gov/periodicals/mcs2024/mcs2024-gallium.pdf",
      "published_at": "2024-01-30T23:59:59Z",
      "available_at": "2024-01-30T23:59:59Z",
      "observed_at": "2024-01-30T23:59:59Z",
      "normalized_evidence": "In Mineral Commodity Summaries 2024, posted 30 January 2024, the U.S. Geological Survey reported that China's primary low-purity gallium price rose from 240 dollars per kilogram in June 2023 to 375 dollars per kilogram by October, a 56 percent increase, citing renewed demand and global concern about reduced gallium availability after China implemented export controls.",
      "evidence_digest": "sha256:30bde4bd37d4c3df2e1627965eb87eeea0c53079d0a551426c99925b5bf03e54"
    },
    {
      "source_id": "gagermanium-usgs-2024-01-30-germanium",
      "role": "OUTCOME",
      "publisher": "U.S. Geological Survey",
      "url": "https://pubs.usgs.gov/periodicals/mcs2024/mcs2024-germanium.pdf",
      "published_at": "2024-01-30T23:59:59Z",
      "available_at": "2024-01-30T23:59:59Z",
      "observed_at": "2024-01-30T23:59:59Z",
      "normalized_evidence": "In Mineral Commodity Summaries 2024, posted 30 January 2024, the U.S. Geological Survey reported virtually no Chinese germanium metal exports in August and September 2023 after export controls began; full-year germanium metal exports fell 10 percent to 39,400 kilograms from 43,700 kilograms in 2022, while European germanium metal prices rose from 1,150 dollars per kilogram in January to 1,550 dollars per kilogram in October and germanium dioxide rose from 725 to 940 dollars per kilogram.",
      "evidence_digest": "sha256:0514c914a06e45662bb22a4361d58cce62d8b37af73564cc1c90d94b4ae19a21"
    },
    {
      "source_id": "imo2020-epa-2019-12-11-hypothesis",
      "role": "HISTORICAL_HYPOTHESIS",
      "publisher": "U.S. Environmental Protection Agency",
      "url": "https://19january2021snapshot.epa.gov/newsreleases/us-refiners-deliver-cleaner-marine-diesel-fuel-key-regulatory-change_.html",
      "published_at": "2019-12-11T23:59:59Z",
      "available_at": "2019-12-11T23:59:59Z",
      "normalized_evidence": "On 11 December 2019, the U.S. Environmental Protection Agency stated that the global marine fuel sulfur limit would fall from 35,000 parts per million to 5,000 parts per million on 1 January 2020 and that this reduction was expected to lead to significant health and welfare benefits globally.",
      "evidence_digest": "sha256:3b950970e6cf3e880b8f966eef976e89fe812285ae927eaae74943f78c82e6de"
    },
    {
      "source_id": "imo2020-imo-2021-01-28-outcome",
      "role": "OUTCOME",
      "publisher": "International Maritime Organization",
      "url": "https://www.imo.org/en/mediacentre/pressbriefings/pages/02-imo-2020.aspx",
      "published_at": "2021-01-28T23:59:59Z",
      "available_at": "2021-01-28T23:59:59Z",
      "observed_at": "2021-01-28T23:59:59Z",
      "normalized_evidence": "On 28 January 2021, the International Maritime Organization reported that implementation of the 0.50 percent marine-fuel sulfur limit through 2020 had produced a 70 percent cut in total sulfur oxide emissions from shipping and that only 55 cases of compliant fuel being unavailable had been reported in its GISIS system.",
      "evidence_digest": "sha256:d7ff0b28ac1fcef95edbe7bf863bcf0eadf69b7623f16c5e08e2321021be350c"
    }
  ],
